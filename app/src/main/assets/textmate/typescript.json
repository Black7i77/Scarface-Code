{
  "name": "TypeScript",
  "scopeName": "source.typescript",
  "patterns": [
    {
      "name": "comment.line",
      "match": "//.*$"
    },
    {
      "name": "comment.block",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.double",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric",
      "match": "\\b(?:0[xX][0-9a-fA-F]+|\\d+(?:\\.\\d+)?)\\b"
    },
    {
      "name": "keyword.control",
      "match": "\\b(?:abstract|any|as|async|await|boolean|break|case|catch|class|const|constructor|continue|declare|default|else|enum|export|extends|false|finally|for|from|function|if|implements|import|in|interface|keyof|let|namespace|never|new|null|number|of|private|protected|public|readonly|return|static|string|super|switch|this|throw|true|try|type|typeof|undefined|unknown|var|void|while|yield|console)\\b"
    },
    {
      "name": "entity.name.function",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
    },
    {
      "name": "variable.other",
      "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
    },
    {
      "name": "keyword.operator",
      "match": "[+*/%=!<>|&:-]+"
    }
  ]
}
