{
  "name": "Markdown",
  "scopeName": "source.markdown",
  "patterns": [
    {
      "name": "markup.heading",
      "match": "^#{1,6}\\s.*$"
    },
    {
      "name": "markup.bold",
      "match": "\\*\\*[^*]+\\*\\*"
    },
    {
      "name": "string.quoted",
      "begin": "`",
      "end": "`"
    },
    {
      "name": "markup.underline.link",
      "match": "\\[[^\\]]+\\]\\([^)]*\\)"
    }
  ]
}
