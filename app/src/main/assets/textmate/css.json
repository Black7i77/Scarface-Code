{
  "name": "CSS",
  "scopeName": "source.css",
  "patterns": [
    {
      "name": "comment.line",
      "match": "//.*$"
    },
    {
      "name": "comment.block",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.double",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric",
      "match": "\\b(?:0[xX][0-9a-fA-F]+|\\d+(?:\\.\\d+)?)\\b"
    },
    {
      "name": "keyword.control",
      "match": "\\b(?:color|background|display|flex|grid|margin|padding|border|width|height|position|absolute|relative|font\\-size|font\\-family|align\\-items|justify\\-content)\\b"
    },
    {
      "name": "entity.name.function",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
    },
    {
      "name": "variable.other",
      "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
    },
    {
      "name": "keyword.operator",
      "match": "[+*/%=!<>|&:-]+"
    }
  ]
}
