{
  "name": "Python",
  "scopeName": "source.python",
  "patterns": [
    {
      "name": "comment.line",
      "match": "#.*$"
    },
    {
      "name": "comment.block",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.multi",
      "begin": "'''",
      "end": "'''"
    },
    {
      "name": "string.quoted.multi",
      "begin": "\"\"\"",
      "end": "\"\"\""
    },
    {
      "name": "string.quoted.double",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric",
      "match": "\\b(?:0[xX][0-9a-fA-F]+|\\d+(?:\\.\\d+)?)\\b"
    },
    {
      "name": "keyword.control",
      "match": "\\b(?:False|None|True|and|as|assert|async|await|break|class|continue|def|del|elif|else|except|finally|for|from|global|if|import|in|is|lambda|nonlocal|not|or|pass|raise|return|try|while|with|yield|print|range|len|str|int|list|dict|set|tuple|open|input)\\b"
    },
    {
      "name": "entity.name.function",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
    },
    {
      "name": "variable.other",
      "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
    },
    {
      "name": "keyword.operator",
      "match": "[+*/%=!<>|&:-]+"
    }
  ]
}
